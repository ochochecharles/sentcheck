PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5434/sentcheck
# 32 random bytes as hex. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Google (Gmail) OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Microsoft (Outlook) OAuth — https://portal.azure.com
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback

# How often to sync sent mail (minutes)
SYNC_INTERVAL_MINUTES=15